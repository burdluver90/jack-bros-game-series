:: Bestiary Styles [stylesheet]
#bestiary { position: fixed; inset: 0; z-index: 2100; background: rgba(5,5,3,.92); overflow-y: auto; padding: 24px 16px 40px; }
#bestiary .bwrap { max-width: 1000px; margin: 0 auto; }
#bestiary h2 { margin: 0 0 4px; font: 900 2rem "Arial Black", Arial, sans-serif; color: #fde68a; letter-spacing: .04em; }
#bestiary .bsub { color: #c7c2a4; margin: 0 0 18px; }
#bestiary .bclose { position: sticky; top: 0; float: right; padding: .4em 1em; border-radius: 99px; border: 1px solid #fde68a; background: #2a2610; color: #fde68a; cursor: pointer; }
#bestiary .bgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; clear: both; }
#bestiary .bcard { background: #16140c; border: 1px solid #4a4528; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; }
#bestiary .bcard.friend { border-color: #4fd18b; }
#bestiary .bcard .bimg { aspect-ratio: 4 / 3; background: #000; display: flex; align-items: center; justify-content: center; overflow: hidden; }
#bestiary .bcard .bimg img { width: 100%; height: 100%; object-fit: contain; }
#bestiary .bcard.locked .bimg { font: 900 3rem "Arial Black", Arial; color: #3a3520; }
#bestiary .bcard .bbody { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 6px; }
#bestiary .bcard h3 { margin: 0; font-size: 1.05rem; color: #f8f6ee; }
#bestiary .bcard .btag { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: #9db8ff; }
#bestiary .bcard p { margin: 0; font-size: .86rem; line-height: 1.4; color: #d6d3c4; }
#bestiary .bcard .btip { color: #fde68a; }
#bestiary .bcard .bstat { font-size: .78rem; color: #fca5a5; }
#bestiary .bcard .bstat.won { color: #86efac; }
#hud .bestbtn { border-radius: 99px; border: 1px solid #a16207; background: #2a2610; color: #fde68a; padding: .25em .8em; cursor: pointer; font-size: .8rem; }
.bestlink { text-align: center; margin: 6px 0 0; }
.preybox { margin: 10px auto; max-width: 640px; padding: 10px 14px; border: 1px dashed #86efac; border-radius: 10px; background: rgba(20, 50, 36, .55); }
.preybox p { margin: 0 0 6px; }
.preybox .preyout { color: #bbf7d0; }
.preybox .preybtn + .preybtn { margin-left: 8px; }
.preybtn { display: inline-block; padding: .35em 1em; border-radius: 99px; border: 1px solid #4fd18b; background: #143224; color: #c9ffe0; cursor: pointer; text-decoration: none; }
#bestiary .btabs { display: flex; gap: 8px; margin: 0 0 16px; clear: both; }
#bestiary .btab { padding: .35em 1em; border-radius: 99px; border: 1px solid #4a4528; background: #16140c; color: #c7c2a4; cursor: pointer; }
#bestiary .bshow { margin-left: auto; padding: .35em 1em; border-radius: 99px; border: 1px solid #4a4528; background: #16140c; color: #9db8ff; cursor: pointer; }
#bestiary .bshow.on { border-color: #9db8ff; background: #101a30; }
#bestiary .btab.on { border-color: #fde68a; color: #fde68a; background: #2a2610; }
#bestiary .fchain { display: flex; flex-direction: column; align-items: center; gap: 0; }
#bestiary .ftier { width: 100%; background: #16140c; border: 1px solid #4a4528; border-radius: 12px; padding: 10px 12px 12px; }
#bestiary .ftier.apex { border-color: #b91c1c; background: #1f0d0b; }
#bestiary .ftier h3 { margin: 0 0 8px; font: 900 .85rem "Arial Black", Arial; letter-spacing: .12em; text-transform: uppercase; color: #fde68a; }
#bestiary .ftier.apex h3 { color: #fca5a5; }
#bestiary .ftier .fnote { margin: -4px 0 8px; font-size: .8rem; color: #a8a38a; }
#bestiary .frow { display: flex; flex-wrap: wrap; gap: 8px; }
#bestiary .fmon { width: 96px; text-align: center; font-size: .75rem; color: #e7e4d4; }
#bestiary .fmon .fimg { width: 96px; height: 72px; background: #000; border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center; font: 900 1.6rem "Arial Black", Arial; color: #3a3520; }
#bestiary .fmon .fimg img { width: 100%; height: 100%; object-fit: contain; }
#bestiary .farrow { font-size: 1.4rem; color: #8a845e; line-height: 1.6; }

:: Bestiary Script [script]
/* the bestiary remembers every creature across all playthroughs (saved in the browser) */
setup.BEASTS = [
  { id: 'virus', name: 'The Virus', tag: 'Friend', friend: true, img: 'img_Qimage26', img2: 'img_Qimage79', seen2: ['One reason my kind is (Q80)'],
    seen: ['Fight (Q9)', "Wait don't run (Q11)", 'I am a virus basically (Q12)'], deaths: ['You are brutally strangled and (Q10)'],
    desc: 'A virus, which is basically a bacteria, but it does not want to hurt you. After its mutation it is about 12 times stronger, and it always finds you again. Even after mutating, the virus has never tested its strength against the Concierge. It could win, or it could be torn apart, so it lowers its tendrils politely and stays out of the way of the Concierge.',
    tip: 'Do not fight it and do not run. Listen to it, and follow it.' },
  { id: 'bacteria', name: 'Bacteria', tag: 'Hunter', img: 'img_Qimage15', img2: 'art_bacteria', seen2: ['Bacteria Attack'],
    seen: ["What's this Bacteria (Q5)", 'Bacteria Attack'], deaths: ['You become lost becoming a (Q36)'], beat: ['Bacteria Absorb'],
    desc: 'Bacteriform life studied by the Async Research Institute. Bashful, but it hunts anyone who gets lost on their own. Cut one of its black tendrils and two grow back. It and the virus\'s kind have always been at war, and the virus hates it.',
    tip: 'Never wander off alone. Stay with the virus. If one attacks, the virus will kill it and take its black tendrils, and the Concierge fight gets easier.' },
  { id: 'lizard', name: 'Poolrooms Lizard', tag: 'Hunter', img: 'img_Qimage40',
    seen: ['RUN (Q34)', 'Left (Q35)'], deaths: ['You go right and reach (Q39)'],
    desc: 'A red, scaly thing that chases you through the poolrooms. The black water eats anything dead, including it.',
    tip: 'Turn around and RUN, and take the way down.' },
  { id: 'skinstealer', name: 'Skin Stealer', tag: 'Disguised hunter', img: 'img_Qimage54', battle: 'skinstealer',
    seen: ['The skinstealer almost killed me (Q45)', 'Run (Q49)', 'Level 1 Dark Hall', 'Battle Skin Stealer'], deaths: ['As its teeth sink in (Q52)', 'Skin Stealer Ending'],
    desc: 'It wears the skin of the people it catches, like the hazmat explorer who said hi. Do not trust anyone.',
    tip: 'Never walk toward it. Hide, run, or fight it with a crowbar: it rips its stolen skin right off.' },
  { id: 'smiler', name: 'The Smiler', tag: 'Sanity', img: 'art_lostmind',
    seen: ['Lost Your Mind'], deaths: ['Lost Your Mind'],
    desc: 'When your sanity runs out, the walls start smiling back. Then it finds you.',
    tip: 'Drink almond water before your sanity hits zero, and always carry a spare.' },
  { id: 'watcher', name: 'The Night Watcher', tag: 'Hunter', img: 'img_Qimage68',
    seen: ['Wait here (Q63)', 'You hide and you hear (Q64)'], deaths: ['It sees you and it (Q72)', "You don't make it to (Q73)"],
    desc: 'Level 94 is peaceful in the day. At night, something huge walks between the houses, strong enough to flip a car.',
    tip: 'After dark: stay put, hide, and never look out the window.' },
  { id: 'clown', name: 'The Clown', tag: 'Hunter', img: 'img_Qimage75',
    seen: ['Whos him? Maybe the clown? (Q69)', 'You keep your eyes on (Q70)', 'As long as he thinks (Q76)'], deaths: ['You are crushed to death (Q74)'],
    desc: 'A huge clown with a giant hammer, inside the castle amusement park. As long as he thinks he is being watched, he will not attack. Nobody knows who would win in a fight between the Clown and the Concierge, so he bows to it and avoids such a risky fight.',
    tip: 'Never take your eyes off him. Let the doll watch him while you fix the coaster.' },
  { id: 'doll', name: 'The Doll', tag: 'Friend', friend: true, img: 'img_Qimage69',
    seen: ['Ok the doll is watching (Q77)'], deaths: [],
    desc: 'A stitched-up doll with button eyes. It stares at the clown so you do not have to.',
    tip: 'Put it in front of the clown, then get the roller coaster working.' },
  { id: 'partygoers', name: 'Partygoers', tag: 'Level Fun', img: 'art_levelfun', battle: 'partygoers',
    seen: ['Level Fun', 'Fun With The Virus', 'Party Chase', 'Battle Partygoers'], deaths: ['Party Cake Ending', 'Smile Ending', 'Partygoer Caught Ending', 'Party Forever Ending', 'Present Ending'],
    desc: 'Tall yellow figures with drawn-on smiles. They hunt by sound and the music never stops. =)',
    tip: 'Be quiet, never eat the cake, never smile back. A baseball bat knocks them flying.' },
  { id: 'giant', name: 'The Biggest Partygoer', tag: 'Level Fun', img: 'art_funhold',
    seen: ['The Way Out'], deaths: ['Biggest Partygoer Ending'],
    desc: 'It guards the way out of Level Fun. Its smile stretches all the way around its head.',
    tip: 'Partygoers like hats. Wear one and walk right past it.' },
  { id: 'crawler', name: 'Pipe Crawler', tag: 'Level 2', img: 'art_crawler', battle: 'crawler',
    seen: ['Level 2 Crawler', 'Battle Pipe Crawler'], deaths: ['Crawler Ending', 'Steam Ending'],
    desc: 'A knot of rusty metal legs and tiny red lights that lives in the vents of Pipe Dreams.',
    tip: 'It is held together by bolts. A pipe wrench takes it apart.' },
  { id: 'redeyes', name: 'Light Haters', tag: 'Level 6', img: 'art_level6',
    seen: ['Level 6 Lights Out'], deaths: [],
    desc: 'Pairs of red eyes in the total darkness of Lights Out.',
    tip: 'They hate light. A flashlight or a swing of your weapon scatters them.' },
  { id: 'whisperer', name: 'The Whisperer', tag: 'Level 6', img: 'art_level6',
    seen: ['Level 6 Lights Out'], deaths: ['Whispers Ending'],
    desc: 'Something on the left side of the dark that knows your name.',
    tip: 'Whispers in the dark are never friendly. Go the other way.' },
  { id: 'chaser', name: 'The Red Dark', tag: 'Level !', img: 'art_levelrun',
    seen: ['Level Run For Your Life'], deaths: ['Run For Your Life Ending'],
    desc: 'When the lights turn red, the dark itself starts moving down the hallway. Fast.',
    tip: 'RUN. Do not stop. Slide under the door.' },
  { id: 'mannequins', name: 'Mannequin Dancers', tag: 'Grand Hotel', img: 'art_h_ballroom',
    seen: ['Hotel Ballroom', 'Hotel Stage', 'Hotel Dance'], deaths: ['Dance Forever Ending'],
    desc: 'They waltz in the ballroom without a sound. The band knows the boiler code.',
    tip: 'Grab the sheet music and run. Dancing costs sanity, but it shows you the code too.' },
  { id: 'concierge', name: 'The Concierge', tag: 'Grand Hotel boss', img: 'art_h_desk', battle: 'concierge',
    seen: ['Hotel Concierge', 'Hotel Boiler Room', 'Battle Concierge'], deaths: ['Checkout Ending', 'Bell Ending', 'Housekeeping Ending'],
    desc: 'Very tall, a red uniform, white gloves, and a smooth porcelain face with a painted smile. Guests never check out. The Concierge only likes polite creatures. The top hunters know this, and even the other two apex predators, the mutated virus and the Clown, bow to it when they pass through the hotel. The hunters and scavengers are not smart enough to mind their manners, so the Concierge hunts them. But it loves small things, so prey always get a free pass.',
    tip: 'Ring the bell once, ask nicely, hide in the wardrobe. Polite guests may check out. Its cracked face is weak to the sword.' },
  { id: 'hound', name: 'The Hound', tag: 'Grand Hotel', img: 'art_h_stairs', battle: 'hound',
    seen: ['Hotel Basement Stairs', 'Battle Hound'], deaths: ['Hound Ending'],
    desc: 'A long black thing with white eyes that sleeps across the basement stairs, listening.',
    tip: 'Tiptoe, take the elevator or the shaft, or charge it with the fire axe. Never shine a light at it.' },
  { id: 'static', name: 'The Static Face', tag: 'Grand Hotel', img: 'art_h_room',
    seen: ['Hotel Room 211'], deaths: ['Static Ending'],
    desc: 'A smiling face slowly forming in the static of the TV in Room 211.',
    tip: 'Turn the TV off. Do not keep watching.' },
  { id: 'voice', name: 'The Voice in 217', tag: 'Grand Hotel', img: 'art_h_hall2',
    seen: ['Hotel Room 217'], deaths: ['Knock Ending'],
    desc: 'It knocks from inside Room 217 using the voice of someone you know.',
    tip: 'Do not open the door. Knock back three times.' },
  { id: 'hatchlings', name: 'Virus Hatchlings', tag: 'Prey (never seen)', friend: true, img: 'art_p_hatch',
    seen: ['Bacteria Absorb'], deaths: [],
    desc: 'Tiny viruses that have not mutated yet, like the virus was when it was small. You never see one: the virus told you about them. They cannot fight back, and the Bacteria eat them easily. Only about 1 in 3 hatchlings ever grows bigger, and only about 1 in 5 survives long enough to mutate. But the ones that do mutate turn the tables: they pick off the Bacteria the same way the Bacteria once picked them off when they were small.',
    tip: 'There is nothing you can do for them. But every Bacteria the virus kills is one less hunting the hatchlings.' },
  { id: 'moths', name: 'Almond Moths', tag: 'Helpful prey', friend: true, img: 'art_p_moths',
    seen: ['Level 1'], deaths: [],
    desc: 'Pale, dusty moths that can smell almond water from a whole level away. They are harmless, and almost everything eats them.',
    tip: 'Follow them. They always fly toward almond water.' },
  { id: 'mice', name: 'Pipe Mice', tag: 'Helpful prey', friend: true, img: 'art_p_mice',
    seen: ['Level 2 Pipe Dreams'], deaths: [],
    desc: 'Tiny grey mice that live along the pipes of Pipe Dreams. They never, ever touch a hot pipe.',
    tip: 'Go where the mice go. They know which way is safe.' },
  { id: 'glowbugs', name: 'Glow Bugs', tag: 'Helpful prey', friend: true, img: 'art_p_glow',
    seen: ['Level 6 Lights Out'], deaths: [],
    desc: 'A drifting cloud of tiny glowing bugs in the darkness of Lights Out. The Light Haters cannot stand them.',
    tip: 'No flashlight? Cup a handful of glow bugs and use them as a light.' },
  { id: 'bellmouse', name: 'The Bellhop Mouse', tag: 'Helpful prey', friend: true, img: 'art_p_bellmouse',
    seen: ['Hotel Lobby'], deaths: [],
    desc: 'A mouse in a tiny red bellhop cap who lives under the front desk of the Grand Hotel. It hears everything the band plays.',
    tip: 'Be kind to it and it scratches the first number of the boiler code into the carpet. Share a sip of almond water and it gives you the whole code. It only drinks a quarter of the bottle, so you still get 75 sanity from the rest.' }
];
/* helpful prey: each one offers a little help once per run, in the passage where you meet it */
setup.PREY = {
  'Level 1': { id: 'moths', text: 'A few pale moths flutter past you and drift off toward a crack in the wall.', btn: 'Follow the moths',
    use: function () { State.variables.sanity = Math.min(100, State.variables.sanity + 15); return 'The moths lead you to a puddle of almond water dripping from the ceiling. You drink. <b>+15 sanity</b>.'; } },
  'Level 2 Pipe Dreams': { id: 'mice', text: 'Three tiny grey mice scurry past your feet, running along the cold blue pipe.', btn: 'Watch where the mice go',
    use: function () { State.variables.sanity = Math.min(100, State.variables.sanity + 5); return 'The mice run along the <b>cold blue pipe</b> and stay far away from the hot one. Smart mice. You feel a little calmer. <b>+5 sanity</b>.'; } },
  'Level 6 Lights Out': { id: 'glowbugs', text: 'A tiny green light blinks near your face. Then another. A cloud of glow bugs is drifting by.', btn: 'Cup a handful of glow bugs',
    use: function () { setTimeout(function () { Engine.play('Lights Out Flashlight'); }, 1400); return 'You cup them in your hands. They glow brighter, and the red eyes shriek and back away.'; } },
  'Hotel Lobby': { id: 'bellmouse', text: 'A mouse in a tiny red bellhop cap peeks out from under the front desk.', btn: 'Kneel down and be nice to the mouse',
    use: function () { var c = setup.boiler(); return 'The mouse sniffs your hand, then scratches a number into the carpet with its claw: <b>' + c.charAt(0) + '</b>. It taps it twice, then points its nose at the ballroom.'; },
    /* a second choice: share your almond water */
    btn2: 'Give the mouse a sip of almond water', need2: function () { return setup.has('almond'); },
    use2: function () {
      var v = State.variables, c = setup.boiler();
      v.inv.splice(v.inv.indexOf('almond'), 1);
      v.sanity = Math.min(100, v.sanity + 75);
      return 'The mouse squeaks happily and takes a big sip. It only drinks a quarter of the bottle, then hands the rest back to you. You drink what is left (<b>+75 sanity</b> instead of a full bottle). '
        + 'Then the mouse scratches three numbers into the carpet, one after another: <b>' + c.split('').join(' ') + '</b>. The whole boiler code.';
    } }
};
$(document).on(':passagedisplay', function (ev) {
  var p = setup.PREY[ev.passage.title], v = State.variables;
  if (!p) { return; }
  v.preyUsed = v.preyUsed || {};
  var box = $('<div class="preybox"><p>' + p.text + '</p></div>');
  if (!v.preyUsed[p.id]) {
    $('<a class="preybtn">\u{1F43E} ' + p.btn + '</a>').on('click', function () {
      v.preyUsed[p.id] = true; box.find('.preybtn').remove();
      box.append('<p class="preyout">' + p.use() + '</p>'); setup.hud();
    }).appendTo(box);
    if (p.btn2 && p.need2()) {
      $('<a class="preybtn">\u{1F4A7} ' + p.btn2 + '</a>').on('click', function () {
        v.preyUsed[p.id] = true; box.find('.preybtn').remove();
        box.append('<p class="preyout">' + p.use2() + '</p>'); setup.hud();
      }).appendTo(box);
    }
  }
  /* wait a moment: some scenes finish drawing their choices after the passage shows */
  setTimeout(function () {
    /* the old scene is still fading out, so use the newest passage */
    var cur = $('#passages .passage').not('.passage-out').last();
    if (State.passage !== ev.passage.title || cur.find('.preybox').length) { return; }
    var ch = cur.find('.choices').first();
    if (ch.length) { box.insertBefore(ch); } else { box.appendTo(cur); }
  }, 80);
});
setup.best = function () { var b = recall('bestiary', null); return b && typeof b === 'object' ? b : {}; };
setup.bestMark = function (id, field) {
  var b = setup.best(), e = b[id] || {}, first = !e.seen;
  e.seen = true; if (field === 'died') { e.died = (e.died || 0) + 1; } else if (field) { e[field] = true; }
  b[id] = e; memorize('bestiary', b);
  if (first) { var beast = setup.BEASTS.filter(function (x) { return x.id === id; })[0]; setup.toast('\u{1F4D6} New bestiary entry: ' + beast.name); }
};
$(document).on(':passagedisplay', function (ev) {
  var t = ev.passage.title;
  setup.BEASTS.forEach(function (x) {
    if (x.deaths.indexOf(t) >= 0) { setup.bestMark(x.id, 'died'); }
    else if (x.seen.indexOf(t) >= 0) { setup.bestMark(x.id); }
    if (x.beat && x.beat.indexOf(t) >= 0) { setup.bestMark(x.id, 'beaten'); }
    if (x.seen2 && x.seen2.indexOf(t) >= 0) { setup.bestMark(x.id, 'form2'); }
  });
});
setup.bestImg = function (name) { var p = Story.get(name); return p && p.text ? p.text.trim() : ''; };
setup.bestView = function () {
  if (!setup.showAll) { return setup.best(); }
  var all = {}; setup.BEASTS.forEach(function (x) { all[x.id] = { seen: true, form2: true, beaten: true }; }); return all;
};
setup.openBestiary = function () {
  var b = setup.bestView(), found = 0, cards = '';
  setup.BEASTS.forEach(function (x) {
    var e = b[x.id];
    if (!e || !e.seen) {
      cards += '<div class="bcard locked"><div class="bimg">???</div><div class="bbody"><h3>???</h3><p>You have not met this one yet.</p></div></div>';
      return;
    }
    found++;
    var img = setup.bestImg(e.form2 && x.img2 ? x.img2 : x.img), learned = e.beaten || e.died, stat = '';
    if (e.beaten) { stat += '<div class="bstat won">\u{2714} Beaten in battle</div>'; }
    if (e.died) { stat += '<div class="bstat">\u{1F480} ' + (x.friend ? 'Hurt you ' : 'Killed you ') + e.died + (e.died === 1 ? ' time' : ' times') + '</div>'; }
    cards += '<div class="bcard' + (x.friend ? ' friend' : '') + '"><div class="bimg"><img src="' + img + '" alt="">' + '</div><div class="bbody">' +
      '<span class="btag">' + x.tag + '</span><h3>' + x.name + '</h3><p>' + x.desc + '</p>' +
      '<p class="btip">' + (learned || x.friend ? '\u{1F4A1} ' + x.tip : '\u{1F512} Survival tip: beat it or learn the hard way.') + '</p>' + stat + '</div></div>';
  });
  $('#bestiary').remove();
  $('<div id="bestiary"><div class="bwrap"><button class="bclose">Close</button><h2>\u{1F4D6} Bestiary</h2>' +
    '<p class="bsub">' + found + ' of ' + setup.BEASTS.length + ' creatures found. Tips unlock when you beat a creature or it gets you.</p>' +
    '<div class="btabs"><button class="btab on" data-t="cards">Creatures</button><button class="btab" data-t="chain">\u{1F356} Food chain</button><button class="bshow' + (setup.showAll ? ' on' : '') + '">\u{1F441}\u{FE0F} ' + (setup.showAll ? 'Hide what I have not found' : 'Show everything') + '</button></div>' +
    '<div class="bgrid">' + cards + '</div></div></div>').appendTo('body');
};
/* the food chain: who eats who in the Backrooms. Higher tiers hunt everything below them. */
setup.FOODCHAIN = [
  { name: 'Apex predators', apex: true, note: 'Nothing hunts these. Everything else runs.', list: ['virus2', 'concierge', 'clown'] },
  { name: 'Top hunters', note: 'They hunt almost anything that wanders alone.', list: ['hound', 'skinstealer', 'watcher', 'chaser', 'giant'] },
  { name: 'Hunters', note: 'Dangerous, but they stay out of the apex predators\' way.', list: ['bacteria', 'virus1', 'lizard', 'whisperer', 'static', 'voice', 'smiler'] },
  { name: 'Scavengers', note: 'They pick off the weak and the lost.', list: ['partygoers', 'mannequins', 'crawler', 'redeyes'] },
  { name: 'Prey', note: 'Small, weak, and hunted by nearly everything. Be kind to them and they help you.', list: ['hatchlings', 'doll', 'moths', 'mice', 'glowbugs', 'bellmouse'] }
];
setup.openFoodChain = function () {
  var b = setup.bestView(), tiers = '';
  setup.FOODCHAIN.forEach(function (t, i) {
    var row = '';
    t.list.forEach(function (id) {
      var real = id.replace(/[12]$/, ''), x = setup.BEASTS.filter(function (z) { return z.id === real; })[0], e = b[real] || {};
      var known = x && e.seen && (id !== 'virus2' || e.form2), name = '???', img = '';
      if (known) {
        name = id === 'virus1' ? 'The Virus (before mutation)' : id === 'virus2' ? 'The Virus (after mutation)' : x.name;
        img = '<img src="' + setup.bestImg(id === 'virus2' && x.img2 ? x.img2 : x.img) + '" alt="">';
      }
      row += '<div class="fmon"><div class="fimg">' + (img || '?') + '</div>' + name + '</div>';
    });
    tiers += (i ? '<div class="farrow">\u{25B2}</div>' : '') + '<div class="ftier' + (t.apex ? ' apex' : '') + '"><h3>' + t.name + '</h3><p class="fnote">' + t.note + '</p><div class="frow">' + row + '</div></div>';
  });
  $('#bestiary .bgrid, #bestiary .fchain').remove();
  $('#bestiary .bwrap').append('<div class="fchain">' + tiers + '</div>');
};
$(document).on('click', '#bestiary .btab', function () {
  $('#bestiary .btab').removeClass('on'); $(this).addClass('on');
  if ($(this).attr('data-t') === 'chain') { setup.openFoodChain(); } else { setup.openBestiary(); }
});
$(document).on('click', '#bestiary .bshow', function () { setup.showAll = !setup.showAll; setup.openBestiary(); });
$(document).on('click', '#bestiary .bclose', function () { $('#bestiary').remove(); });
$(document).on('click', '#hud .bestbtn, .bestlink a', function (e) { e.preventDefault(); setup.openBestiary(); });
$(document).on('keydown', function (e) { if (e.key === 'Escape') { $('#bestiary').remove(); } });
